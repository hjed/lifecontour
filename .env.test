# Test Environment Configuration
# Used with: docker compose --profile test --env-file .env.test up

# Database Configuration
DB_NAME=personal_management_test
DB_USER=postgres
DB_PASSWORD=postgres
DB_PORT=5433

# Redis Configuration
REDIS_PORT=6380

# MeiliSearch Configuration
MEILI_PORT=7701
MEILI_MASTER_KEY=test_master_key
MEILI_ENV=development
MEILI_LOG_LEVEL=WARN

# OAuth Configuration
OAUTH_PUBLIC_PORT=4446
OAUTH_ADMIN_PORT=4447
OAUTH_ISSUER=http://localhost:4446
OAUTH_CONSENT_URL=http://localhost:3002/consent
OAUTH_LOGIN_URL=http://localhost:3002/login
OAUTH_SYSTEM_SECRET=test-system-secret-change-in-production
OAUTH_PAIRWISE_SALT=test-salt-change-in-production
OAUTH_LOG_LEVEL=debug
OAUTH_CLIENT_ID=test-client-id
OAUTH_CLIENT_SECRET=test-client-secret
OAUTH_UI_PORT=3002

# Backend Configuration
BUILD_ENV=development
INSTALL_DEV_DEPS=true
BACKEND_PORT=8001
DEBUG=true
LOG_LEVEL=DEBUG
CORS_ORIGINS=http://localhost:3100,http://127.0.0.1:3100,http://frontend:3000
ALLOWED_HOSTS=localhost,127.0.0.1,backend,*
SESSION_SECRET_KEY=test_session_secret_key
SEARCH_INDEX_PREFIX=test_
ENABLE_TELEMETRY=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
OTEL_SERVICE_NAME=personal-management-backend-test
OTEL_RESOURCE_ATTRIBUTES=service.name=personal-management-backend-test,service.version=0.1.0-test
OAUTH_AUTHORIZATION_URL=http://localhost:4446/oauth2/auth
# Use docker-compose.yml defaults that interpolate CONTAINER_PREFIX
# OAUTH_TOKEN_URL=http://oauth-provider:4444/oauth2/token
# OAUTH_USERINFO_URL=http://oauth-provider:4444/userinfo
DISABLE_AUTH=false
ENVIRONMENT=test
ENABLE_TEST_REVIEW_ITEMS=true
# Never fetch real basemap tiles from a test run. A dead address fails fast with
# a connection error, which the map renderer turns into its plain-background
# fallback, so an E2E export of a journal with a GPX route still succeeds
# without the suite becoming a live OpenStreetMap client.
LOGBOOK_TILE_BASE_URL=http://127.0.0.1:1

# Frontend Configuration
NODE_ENV=development
FRONTEND_URL=http://localhost:3100
FRONTEND_PORT=3100
NEXT_PUBLIC_API_URL=http://localhost:8001
NEXT_PUBLIC_OAUTH_PROVIDER_URL=http://localhost:4446
BACKEND_URL=http://backend:8000
WATCHPACK_POLLING=true

# Integration Workers
GOOGLE_CLIENT_ID=test-google-client-id
GOOGLE_CLIENT_SECRET=test-google-client-secret
ENCRYPTION_KEY=test-encryption-key-change-in-production
WORKER_LOG_LEVEL=DEBUG
MAX_CONCURRENT_JOBS=5

