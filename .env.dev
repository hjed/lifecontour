# Development Environment Configuration
# This file contains settings optimized for local Docker development

# Application Settings
DEBUG=true
LOG_LEVEL=DEBUG
SECRET_KEY=dev-secret-key-change-in-production

# Server Settings
HOST=0.0.0.0
PORT=8000
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend-dev,*
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://frontend-dev:3000

# Database Settings (Docker Development)
DATABASE_URL=postgresql://dev_user:dev_password@postgres-dev:5432/personal_management_dev
DATABASE_ECHO=false

# Security Settings
SESSION_SECRET_KEY=dev-session-secret-change-in-production

# OAuth Provider Configuration (Development)
OAUTH_PROVIDER_NAME=generic
OAUTH_CLIENT_ID=dev-client-id
OAUTH_CLIENT_SECRET=dev-client-secret
OAUTH_AUTHORIZATION_URL=http://localhost:4444/oauth2/auth
OAUTH_TOKEN_URL=http://oauth-provider:4444/oauth2/token
OAUTH_USERINFO_URL=http://oauth-provider:4444/userinfo

# GitHub OAuth (Optional - for testing real providers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Microsoft OAuth (Optional - for testing real providers)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Discord OAuth (Optional - for testing real providers)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# External Services
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
IMMICH_BASE_URL=
IMMICH_API_KEY=

# Search Settings (Docker Development)
MEILISEARCH_URL=http://meilisearch-dev:7700
MEILISEARCH_API_KEY=dev_master_key_change_in_production
SEARCH_INDEX_PREFIX=pms_dev_

# Observability (OpenTelemetry)
ENABLE_TELEMETRY=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
OTEL_SERVICE_NAME=personal-management-backend-dev
OTEL_RESOURCE_ATTRIBUTES=service.name=personal-management-backend-dev,service.version=0.1.0-dev,deployment.environment=development

# MCP Settings
MCP_ENABLED=true
MCP_MOUNT_PATH=/mcp-server
