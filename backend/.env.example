# Application Settings
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=your-secret-key-change-in-production

# Server Settings
HOST=0.0.0.0
PORT=8000
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend Settings
FRONTEND_URL=http://localhost:3000

# Database Settings
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/personal_management
DATABASE_ECHO=false

# Security Settings
SESSION_SECRET_KEY=your-session-secret-change-in-production

# OAuth Provider Configuration
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret

# Generic OAuth2 Provider (optional)
OAUTH_PROVIDER_NAME=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_AUTHORIZATION_URL=
OAUTH_TOKEN_URL=
OAUTH_USERINFO_URL=
# OIDC discovery. REQUIRED when the generic provider above is configured: MCP
# auth verifies the upstream id_token against the IdP's JWKS and refuses to
# start without it. For Kanidm the issuer is per-client, e.g.
# https://idm.example.com/oauth2/openid/<client-id>
OAUTH_ISSUER=
# Only needed when the metadata is not served at
# {OAUTH_ISSUER}/.well-known/openid-configuration, or when the backend must
# fetch it from a different address than the one tokens are issued under.
OAUTH_DISCOVERY_URL=
# Expected `aud` for direct REST bearer tokens. Unset skips audience checks.
OAUTH_AUDIENCE=

# External Services
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_ENCRYPTION_KEY=your-fernet-encryption-key
IMMICH_BASE_URL=http://your-immich-instance
IMMICH_API_KEY=your-immich-api-key

# Observability
ENABLE_TELEMETRY=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=personal-management-backend
OTEL_RESOURCE_ATTRIBUTES=service.name=personal-management-backend,service.version=0.1.0,deployment.environment=development
