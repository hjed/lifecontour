# design-sync: staged converter scripts, build output and machine state.
# The durable inputs under .design-sync/ (config.json, NOTES.md, conventions.md,
# docs/, previews/, ds-entry.ts, preview-providers.tsx, preview.css) are committed.
.ds-sync/
ds-bundle/
# Declaration-only tsc output, regenerated by .design-sync/prepare.mjs, which
# runs with `frontend/` as its cwd and writes both of these at this level.
# Anchored with a leading slash: unanchored, `types/` also matched
# `frontend/src/types/`, so a new application type module was silently
# untracked while the ones predating this rule stayed committed.
/types/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules
/index.d.ts
