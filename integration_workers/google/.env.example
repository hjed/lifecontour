# Google Contacts Worker Environment Variables

# Database connection
DATABASE_URL=postgresql://postgres:postgres@database:5432/personal_management

# Redis connection for ARQ task queue
REDIS_URL=redis://redis:6379

# Google API credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Worker configuration
WORKER_ID=google-worker
LOG_LEVEL=INFO
MAX_CONCURRENT_JOBS=5

# Encryption key for token storage (should match main app)
ENCRYPTION_KEY=your-encryption-key-here

# Calendar push notifications
# Public HTTPS base URL Google delivers calendar webhooks to. Leave empty to
# disable push notifications entirely (periodic sync still runs).
WEBHOOK_BASE_URL=
# How far ahead of a watch channel's 7-day expiry to re-register it, in hours.
WEBHOOK_RENEWAL_THRESHOLD_HOURS=48
