# Snipe-IT Integration Worker Configuration
#
# Copy this file to .env and fill in the values for your environment.

# Database connection string (async driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/personal_management

# Redis URL for ARQ task queue and event streams
REDIS_URL=redis://localhost:6379

# Encryption key for token storage (Fernet-compatible, base64-encoded 32 bytes)
ENCRYPTION_KEY=

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Worker identifier (used in logs and consumer groups)
WORKER_ID=snipeit-worker
