# Google Contacts Worker Environment Variables

# Database connection
DATABASE_URL=postgresql://postgres:postgres@database:5432/personal_management

# Redis connection for ARQ task queue
REDIS_URL=redis://redis:6379

# Google API credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Worker configuration
WORKER_ID=google-contacts-worker
LOG_LEVEL=INFO
MAX_CONCURRENT_JOBS=5

# Encryption key for token storage (should match main app)
ENCRYPTION_KEY=your-encryption-key-here
